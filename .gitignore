# Local configuration (contains DB credentials and app secrets)
/config/config.php
/config/*.local.php

# Runtime storage
/storage/media/*
!/storage/media/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/tmp/*
!/storage/tmp/.gitkeep

# Build tooling (only needed on a dev machine, never on Strato)
/tools/node_modules/
/tools/package-lock.json
/node_modules/

# Android build output
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/*.keystore
/android/*.jks

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Browser-test dependencies (development only)
/tests/browser/node_modules
/tests/browser/package-lock.json
