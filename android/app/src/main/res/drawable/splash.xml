<?xml version="1.0" encoding="utf-8"?>
<!--
    The launch screen: the app mark centred on the globe's backdrop.
    Deliberately not scaled to fill, so it looks the same on a phone and on a
    tablet.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/mtlBackground" />

    <item>
        <bitmap
            android:src="@mipmap/ic_launcher_foreground"
            android:gravity="center" />
    </item>
</layer-list>
