<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon. Android 8 and later crop the foreground to whatever shape the
    launcher uses, so the glyph is drawn inside the safe zone and the background
    is a flat colour that can be cropped without losing anything.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/mtlBackground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
